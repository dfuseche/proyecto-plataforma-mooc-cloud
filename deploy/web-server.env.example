# Configuración para el Servidor Web (API REST en VM 1)
PORT=8080

# Base de Datos Administrada (Cloud SQL PostgreSQL - IP Privada)
DATABASE_URL=postgres://mooc_user:CAMBIAR_PASSWORD@10.0.2.X:5432/mooc_db?sslmode=disable

# Redis en su propia VM dedicada (ver docs/entrega3/arquitectura.md) —
# ya no vive en Worker Server (ver deploy/docker-compose.redis.yml)
REDIS_ADDR=10.0.2.3:6379

# Google Cloud Storage (API de Interoperabilidad S3)
MINIO_ENDPOINT=storage.googleapis.com
EXTERNAL_MINIO_ENDPOINT=
MINIO_ACCESS_KEY=GOOG1E_HMAC_ACCESS_KEY_AQUI
MINIO_SECRET_KEY=GOOG1E_HMAC_SECRET_KEY_AQUI
MINIO_SECURE=true
S3_REGION=us-central1
S3_MEDIA_BUCKET=mooc-media-gcp-bucket
S3_BADGE_BUCKET=mooc-badges-gcp-bucket

# JWT Secret
JWT_SECRET=generar-clave-jwt-segura-para-produccion
