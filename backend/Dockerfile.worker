# Stage 1: Build del binario Worker
FROM golang:1.26-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/worker ./cmd/worker

# Stage 2: Runtime con FFmpeg y herramientas de procesamiento de video
FROM alpine:3.19

WORKDIR /app

# Instalar FFmpeg y dependencias para HLS
RUN apk add --no-cache ca-certificates ffmpeg curl

ARG APP_VERSION=entrega-4
ENV APP_VERSION=$APP_VERSION

COPY --from=builder /app/worker /app/worker

# Usuario sin privilegios
RUN addgroup -S app && adduser -S -G app -u 10001 app
USER app

EXPOSE 8080

CMD ["/app/worker"]
